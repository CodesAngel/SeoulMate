# Copy this file to .env and replace the placeholders.
# Hosted Supabase: use the Session pooler string (Connect window); the direct
# db.<ref>.supabase.co host is IPv6-only on the free plan.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
FRONTEND_URL=http://localhost:3000
